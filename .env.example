# Lobi environment variables — copy to .env.local
# (.env.local is gitignored — never commit secrets)

# Local DB
DATABASE_URL=file:./lobi.db

# Master encryption password — used to encrypt OAuth tokens at rest
# Generate with: openssl rand -base64 32
LOBI_MASTER_KEY=

# Better-auth secret — session signing
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010

# Google OAuth (Calendar + Gmail + YouTube — single consent)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify OAuth
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: AI inference key (BYOK at MVP — user can also enter via UI)
ANTHROPIC_API_KEY=
